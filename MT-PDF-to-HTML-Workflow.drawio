<mxCell id="title" value="Mutual Trust — AI PDF to HTML Publishing Workflow" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="-35" width="500" height="40" as="geometry"/></mxCell>
<mxCell id="n1" value="1. WordPress Admin
Create / Edit Insight Post" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="320" height="70" as="geometry"/></mxCell><mxCell id="n2" value="2. Upload PDF
ACF field: fr_file
Choose main + sub category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="145" width="320" height="90" as="geometry"/></mxCell><mxCell id="n3" value="3. Click “Convert to HTML”
AJAX → ai_conversion_status = queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="320" height="85" as="geometry"/></mxCell><mxCell id="n4" value="4. Local mt-ai-watcher.sh
Poll queue ~10s
queued → processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="320" height="95" as="geometry"/></mxCell><mxCell id="n5" value="5. Claude Code CLI
claude -p "insight convert post=&lt;id&gt;"
Reads CLAUDE.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="525" width="320" height="95" as="geometry"/></mxCell><mxCell id="n6" value="6. Read source PDF
Text • images • fonts • layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="320" height="75" as="geometry"/></mxCell><mxCell id="n7" value="7. Classify document family" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="775" width="320" height="65" as="geometry"/></mxCell><mxCell id="n8a" value="Market Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="890" width="230" height="65" as="geometry"/></mxCell><mxCell id="n8b" value="Quarterly Outlook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="385" y="890" width="230" height="65" as="geometry"/></mxCell><mxCell id="n8c" value="Perspective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="740" y="890" width="230" height="65" as="geometry"/></mxCell><mxCell id="n9" value="8. Apply Family Template + MT Framework
Fonts • colours • spacing • components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1010" width="320" height="90" as="geometry"/></mxCell><mxCell id="n10" value="9. Extract Assets
Hero • logo • charts • thumbnails
→ uploads/ai-insights/&lt;slug&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1140" width="320" height="95" as="geometry"/></mxCell><mxCell id="n11" value="10. Generate Responsive HTML
Scoped CSS: .mtai-scope
No PDF page numbers / repeated footers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1275" width="320" height="100" as="geometry"/></mxCell><mxCell id="n12" value="11. Gutenberg Custom HTML Block
&lt;!-- wp:html --&gt; … &lt;!-- /wp:html --&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1415" width="320" height="80" as="geometry"/></mxCell><mxCell id="n13" value="12. Update WordPress Draft
post_content = HTML
remove fr_redirect
status = completed + log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1535" width="320" height="105" as="geometry"/></mxCell><mxCell id="n14" value="13. Human Review / Online Editor
